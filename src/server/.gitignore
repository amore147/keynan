```gitignore
# ==============================
# ENVIRONMENT VARIABLES / SECRETS
# ==============================
.env
.env.*
**/.env
**/.env.*

# Allow safe example files
!.env.example
!**/.env.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# ==============================
# DEPENDENCIES
# ==============================
node_modules/
**/node_modules/

# ==============================
# BUILD OUTPUT
# ==============================
dist/
dist-ssr/
build/
out/
coverage/

# ==============================
# LOGS
# ==============================
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==============================
# OS FILES
# ==============================
.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini

# ==============================
# EDITORS
# ==============================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# ==============================
# CACHE / TEMPORARY FILES
# ==============================
.cache/
.temp/
.tmp/
.eslintcache
.vite/
*.tsbuildinfo

# ==============================
# TEST / LOCAL OUTPUT
# ==============================
.nyc_output/
playwright-report/
test-results/

# ==============================
# LOCAL DATABASE / BACKUPS
# ==============================
*.sqlite
*.sqlite3
*.db
*.bak
*.backup
```
